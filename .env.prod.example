# Template for the root .env consumed by docker-compose.prod.yml. Copy to
# `.env` (already in .gitignore) and fill in real values; never commit it.
#
# Compose reads this file two different ways, and both matter here:
#   - automatically, to resolve ${VAR} interpolation inside the compose file
#     itself (DB_USERNAME/DB_PASSWORD/DB_NAME below, used to build DATABASE_URL
#     and to configure the postgres service directly);
#   - via api's `env_file: .env`, which injects every line here into that
#     container.
# web does NOT read this file. It has its own, much smaller one
# (.env.web.example -> .env.web) on purpose: web is the internet-facing
# Next.js process, and it has no code path that touches Postgres, Devise, or
# any secret below, so it should never be able to leak one.

# ── Postgres ─────────────────────────────────────────────────────────────────
# Avoid ":", "@", "/" in either value: docker-compose.prod.yml builds
# DATABASE_URL by string interpolation, not URL-encoding.
DB_USERNAME=karirkalyan
DB_PASSWORD=
DB_NAME=api_production

# ── api/ (Rails): see api/.env.example for what each does ──────────────────
FRONTEND_URL=https://kk.chairulakmal.com
DEVISE_JWT_SECRET_KEY=
SECRET_KEY_BASE=
SOLID_QUEUE_IN_PUMA=1
HONEYBADGER_API_KEY=
ANTHROPIC_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=
MAILER_FROM=
SMTP_PORT=2587
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
