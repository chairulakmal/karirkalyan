# Template for the root .env consumed by docker-compose.prod.yml. Copy to
# `.env` (already in .gitignore) and fill in real values; never commit it.
#
# Compose reads this file two different ways, and both matter here:
#   - automatically, to resolve ${VAR} interpolation inside the compose file
#     itself (DB_USERNAME/DB_PASSWORD/DB_NAME below reach the postgres service
#     as APP_DB_USER/APP_DB_PASSWORD/POSTGRES_DB, for its healthcheck and its
#     first-boot init script);
#   - via api's `env_file: .env`, which injects every line here into that
#     container.
# web does NOT read this file. It has its own, much smaller one
# (.env.web.example -> .env.web) on purpose: web is the internet-facing
# Next.js process, and it has no code path that touches Postgres, Devise, or
# any secret below, so it should never be able to leak one. The Postgres
# superuser is not here either: it lives in .env.postgres
# (.env.postgres.example), which only the postgres service reads.

# ── Postgres: the app's role ─────────────────────────────────────────────────
# A plain role that owns api_production and everything in it, and nothing
# more: not a superuser. Any characters are fine in the password: Rails reads
# these as discrete values (api/config/database.yml), not as a connection
# string it has to parse.
#
# Changing DB_PASSWORD here does NOT change the database's password. The role
# is created only while initializing an empty data directory, so on an
# existing volume rotation is two steps, in this order:
#
#   docker compose -f docker-compose.prod.yml exec postgres \
#     psql -U "$POSTGRES_USER" -c "ALTER USER karirkalyan_app PASSWORD 'new'"
#
# then edit the line below to match. Get it backwards and postgres fails its
# healthcheck, which is the intended outcome: api is held back rather than
# started against credentials that cannot work. The runbook for creating the
# role on a live database is notes/OPS.md § Move the app off the superuser.
DB_USERNAME=karirkalyan_app
DB_PASSWORD=
DB_NAME=api_production

# ── api/ (Rails): see api/.env.example for what each does ──────────────────
FRONTEND_URL=https://kk.chairulakmal.com
DEVISE_JWT_SECRET_KEY=
SECRET_KEY_BASE=
SOLID_QUEUE_IN_PUMA=1
HONEYBADGER_API_KEY=
ANTHROPIC_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=
MAILER_FROM=
SMTP_PORT=2587
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
