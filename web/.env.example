# URL of the Rails API. Server-side only — never exposed to the browser.
API_URL=http://localhost:3001

# Origin allowlist for the auth route handlers' CSRF check (comma-separated for
# several). Effectively required in production: the same-origin fallback compares
# against the request's Host header, which behind Railway is the *internal*
# origin, so without this every sign-in POST is refused. It fails closed (403,
# sign-in breaks) rather than open, which is why it went unnoticed until an audit.
ALLOWED_ORIGIN=http://localhost:3000
