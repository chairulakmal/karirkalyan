# Template for .env.postgres, read only by the `postgres` service's `env_file:`
# entry in docker-compose.prod.yml. Copy to `.env.postgres` (gitignored), fill
# in real values, `chmod 600` it; never commit it.
#
# This is the cluster superuser the official image bootstraps. Nothing but the
# database container ever sees it: api connects as the plain role in the root
# .env (DB_USERNAME / DB_PASSWORD), and the backups runner reaches Postgres
# over the container's Unix socket via `docker exec`, which needs no password.
# Use it for `docker compose exec postgres psql -U "$POSTGRES_USER"` and for
# nothing else.
#
# On an existing volume, editing POSTGRES_PASSWORD changes nothing: the image
# reads it only while initializing an empty data directory. Rotate with
# `ALTER USER ... PASSWORD` inside the container first, then edit this file.
POSTGRES_USER=karirkalyan
POSTGRES_PASSWORD=
