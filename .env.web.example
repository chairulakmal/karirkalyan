# Template for .env.web, read only by the `web` service's `env_file:` entry
# in docker-compose.prod.yml. Copy to `.env.web` (gitignored) and fill in real
# values; never commit it.
#
# Deliberately separate from the root .env (.env.prod.example), which api
# reads: web is the internet-facing Next.js process and has no code path that
# touches Postgres, Devise, or any secret over there, so it should never be
# able to leak one.

# ── web/ (Next.js): see web/.env.example for what each does ────────────────
ALLOWED_ORIGIN=https://kk.chairulakmal.com
